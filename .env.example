# Khushi settings. Copy to .env locally; on Railway set them as service variables. Never commit real values.

# ── Claude ─────────────────────────────────────────────────────────────
LLM_AUTH=oauth                       # oauth = Claude subscription (claude -p), api_key = pay per use
CLAUDE_CODE_OAUTH_TOKEN=             # `claude setup-token` (the token is ~108 chars, printed over 2 lines)
ANTHROPIC_API_KEY=                   # fallback if the subscription is blocked: then set LLM_AUTH=api_key
# LLM_MODEL_SMART=claude-sonnet-5
# LLM_MODEL_FAST=claude-haiku-4-5-20251001

# ── Safety ─────────────────────────────────────────────────────────────
DRY_RUN=true                         # true = nothing is sent to LinkedIn; set false after one good day

# ── Telegram ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                  # from @BotFather (a new bot just for Khushi)
TELEGRAM_CHAT_ID=                    # your chat with the bot: send /myid to it
APPROVER_IDS=                        # your Telegram user id (from /myid); only you can tap Send/Connect
# GROQ_API_KEY=                      # optional: voice notes

# ── LinkedIn reader (browser, logged in as you) ────────────────────────
LOGIN_VIEWER_URL=                    # https://<railway domain that targets port 6080>, used by /linkedin_login
# PROXY_SERVER=                      # optional sticky residential proxy, e.g. http://host:port
# PROXY_USERNAME=
# PROXY_PASSWORD=
# LINKEDIN_USER_DATA_DIR=            # default <DATA_DIR>/linkedin/profile

# ── LinkedIn app (official API) for comments ───────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/callback

# ── Khushi's routine (IST) ─────────────────────────────────────────────
# SCAN_TIMES=09:00,13:00,18:00
# INBOX_EVERY_MINUTES=120
# FOLLOWUP_TIME=11:00
# REPORT_TIME=20:00
# AUTO_COMMENT=true
# COMMENTS_PER_DAY=10
# FOLLOWUP_AFTER_DAYS=3

# ── Storage ────────────────────────────────────────────────────────────
# DATABASE_URL=                      # empty = SQLite on the volume; or a Supabase Postgres URL
# DATA_DIR=/app/data
# HEALTHCHECK_URL=
